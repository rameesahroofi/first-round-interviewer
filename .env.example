# ============================================================
# Vetto — Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual keys.
#
#   cp .env.example .env
# ============================================================

# --- REQUIRED ---
# Google GenAI (Gemini) API key — used by all pipeline agents
# (resume_parser, jd_parser, gap_analyzer, question_planner,
#  answer_extractor, answer_evaluation, code_evaluator,
#  final_analyzer, linkedin_optimizer, resume_rater)
GOOGLE_API_KEY=your_google_api_key_here

# --- OPTIONAL (LiveKit voice agent) ---
# Required only if you want to use the LiveKit real-time voice agent.
# If not set, the frontend falls back to browser-based speech synthesis.
# Sign up free at https://livekit.io
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here
LIVEKIT_URL=wss://your-project.livekit.cloud
